{
    "name": "farzai/thailand-address",
    "description": "Thai provinces, districts and subdistricts with postal codes and ISO 3166-2 codes, from official sources. Plain PHP, with first-class Laravel support.",
    "keywords": [
        "thailand",
        "province",
        "district",
        "subdistrict",
        "postal-code",
        "address",
        "dopa",
        "iso-3166-2",
        "laravel",
        "validation"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Parkorn Soonthornchai",
            "email": "magician_canobi@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "illuminate/collections": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "suggest": {
        "laravel/framework": "Service provider, facade, validation rules and Eloquent casts are discovered automatically"
    },
    "autoload": {
        "psr-4": {
            "Farzai\\ThailandAddress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farzai\\ThailandAddress\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Farzai\\ThailandAddress\\Laravel\\ThailandAddressServiceProvider"
            ],
            "aliases": {
                "ThailandAddress": "Farzai\\ThailandAddress\\Laravel\\Facades\\ThailandAddress"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "generate": "php tools/generate.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
