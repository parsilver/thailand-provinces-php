{
    "name": "parsilver/thailand-provinces-php",
    "description": "Thai provinces, districts (amphoe/khet), subdistricts (tambon/khwaeng) and postcodes from official sources",
    "keywords": ["thailand", "province", "amphoe", "tambon", "khet", "khwaeng", "postcode", "address", "dopa"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Parkorn Soonthornchai",
            "email": "magician_canobi@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Farzai\\ThailandAddress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farzai\\ThailandAddress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "generate": "php tools/generate.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
